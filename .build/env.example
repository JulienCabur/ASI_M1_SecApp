ELASTIC_VERSION=9.3.1

ELASTIC_PASSWORD='A_CHANGER_MDP_ADMIN'
LOGSTASH_INTERNAL_PASSWORD='A_CHANGER_MDP_LOGSTASH'
KIBANA_SYSTEM_PASSWORD='A_CHANGER_MDP_KIBANA'

METRICBEAT_INTERNAL_PASSWORD='A_CHANGER_MDP_METRICBEAT_ALEATOIRE'
FILEBEAT_INTERNAL_PASSWORD='A_CHANGER_MDP_FILEBEAT_ALEATOIRE'
HEARTBEAT_INTERNAL_PASSWORD='A_CHANGER_MDP_HEARTBEAT_ALEATOIRE'
MONITORING_INTERNAL_PASSWORD='A_CHANGER_MDP_MONITORING_ALEATOIRE'
BEATS_SYSTEM_PASSWORD='A_CHANGER_MDP_BEATS_ALEATOIRE'

XPACK_ENCRYPTION_KEY='A_CHANGER_MDP_XPACK_ALEATOIRE'     # Min 32 caractere

# --- Keycloak / PostgreSQL ---
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# --- PKI / TLS (utilisés par Keycloak pour présenter son certificat HTTPS) ---
# SERVER_KEY_PASS  : mot de passe de la clé privée serveur (peut rester vide si encrypt_key=no dans server.conf)
SERVER_KEY_PASS=
# KEYCLOAK_TRUSTSTORE_PASSWORD : mot de passe du truststore PKCS#12 importé par Keycloak
KEYCLOAK_TRUSTSTORE_PASSWORD=
